FROM python:3.12-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app \
    PORT=7860

# Install curl
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

# Install dependencies
COPY backend/requirements.txt ./
RUN pip install --upgrade pip && pip install -r requirements.txt

# Copy backend application and scripts
COPY backend ./backend
COPY scripts ./scripts

# Create non-root user (Hugging Face Spaces runs as user 1000)
RUN useradd -m -u 1000 user && \
    chown -R user:user /app
USER user

# Hugging Face Spaces listens on port 7860
EXPOSE 7860

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -f http://127.0.0.1:7860/health/live || exit 1

# Launch with 4 workers on the 2 dedicated vCPUs
CMD ["sh", "-c", "python scripts/seed.py && uvicorn backend.app.main:app --host 0.0.0.0 --port 7860 --workers 4 --proxy-headers --forwarded-allow-ips='*'"]
