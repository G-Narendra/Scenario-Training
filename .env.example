# Environment & App Config
ENVIRONMENT=development
DEBUG=false
APP_NAME="Flight Simulator for Difficult Conversations"
APP_VERSION=1.0.0
HOST=127.0.0.1
PORT=8000

# Security & Auth
SECRET_KEY=change-this-to-a-secure-random-secret-key-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
DEFAULT_COHORT_DURATION_DAYS=30
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# Database
# Use SQLite for fast local development and unit tests:
DATABASE_URL=sqlite+aiosqlite:///./data.db
# For PostgreSQL via docker-compose:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/scenario_training

# AI Providers
# Options: mock, anthropic, openai
DEFAULT_LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Voice Providers
# Options: mock, openai_realtime
DEFAULT_VOICE_PROVIDER=mock

# Live test flag (0 = disabled, 1 = enabled)
RUN_LIVE_TESTS=0

# CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Cost caps (USD)
DEFAULT_COHORT_BUDGET_CAP_USD=100.0
SESSION_TOKEN_LIMIT=4000
SESSION_AUDIO_MINUTES_LIMIT=15.0
